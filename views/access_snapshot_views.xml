<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_oav_snapshot" model="ir.actions.act_window">
        <field name="name">Access Scan Snapshots</field>
        <field name="res_model">oav.access.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state': 'completed'}</field>
    </record>

    <record id="view_oav_snapshot_list" model="ir.ui.view">
        <field name="name">oav.access.snapshot.list</field>
        <field name="model">oav.access.snapshot</field>
        <field name="arch" type="xml">
            <list string="Access Scan Snapshots">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="requested_by"/>
                <field name="requested_at"/>
                <field name="completed_at"/>
                <field name="node_count"/>
                <field name="edge_count"/>
                <field name="finding_count"/>
            </list>
        </field>
    </record>

    <record id="view_oav_snapshot_form" model="ir.ui.view">
        <field name="name">oav.access.snapshot.form</field>
        <field name="model">oav.access.snapshot</field>
        <field name="arch" type="xml">
            <form string="Access Scan Snapshot" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="queued,running,completed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="requested_by"/>
                            <field name="requested_at"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="failed_at"/>
                            <field name="scan_duration_seconds"/>
                        </group>
                    </group>
                    <group string="Counts">
                        <field name="node_count"/>
                        <field name="edge_count"/>
                        <field name="finding_count"/>
                        <field name="retention_count"/>
                    </group>
                    <group string="Failure">
                        <field name="error_message" nolabel="1" placeholder="No error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

