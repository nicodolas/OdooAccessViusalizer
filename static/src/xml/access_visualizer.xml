<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_access_visualizer.AccessVisualizerAction" owl="1">
        <div class="oav_root">
            <header class="oav_header">
                <div class="oav_brand">
                    <div class="oav_kicker">SECURITY CONTROL ROOM · ODOO 19</div>
                    <h1>Access Visualizer</h1>
                    <p>Understand who can do what and why.</p>
                </div>
                <div class="oav_header_actions">
                    <div t-if="state.dashboard?.latest" class="oav_last_scan">
                        <span>Latest snapshot</span>
                        <strong><t t-esc="state.dashboard.latest.name"/></strong>
                    </div>
                    <button class="btn oav_btn oav_btn_accent" t-on-click="enqueueScan">
                        <i class="fa fa-refresh me-1"/> Run rescan
                    </button>
                </div>
            </header>

            <div t-if="state.error" class="alert alert-danger oav_alert" role="alert">
                <strong>Something needs attention.</strong>
                <span><t t-esc="state.error"/></span>
            </div>
            <div t-if="state.loading" class="oav_loading">
                <span class="oav_loading_mark"/> Preparing your security map…
            </div>

            <div t-if="!state.loading and !state.dashboard?.latest" class="oav_empty">
                <div class="oav_empty_mark">◎</div>
                <div>
                    <div class="oav_kicker">NO SNAPSHOT YET</div>
                    <h2>Start with a read-only scan</h2>
                    <p>We will map the security structure without changing a single access rule.</p>
                    <button class="btn oav_btn oav_btn_accent" t-on-click="enqueueScan">Run first scan</button>
                </div>
            </div>

            <main t-if="!state.loading and state.dashboard?.latest" class="oav_main">
                <section class="oav_status_line">
                    <div class="oav_status_dot" t-att-class="state.dashboard.active ? 'is_running' : 'is_ready'"/>
                    <span t-if="state.dashboard.active">A new scan is running in the background.</span>
                    <span t-else="">Snapshot ready for investigation.</span>
                    <span class="oav_status_separator">·</span>
                    <span><t t-esc="state.dashboard.latest.name"/></span>
                </section>

                <nav class="oav_tabs" aria-label="Visualizer sections">
                    <button data-tab="overview" t-att-class="state.activeTab === 'overview' ? 'is_active' : ''" t-on-click="setTab">Overview</button>
                    <button data-tab="graph" t-att-class="state.activeTab === 'graph' ? 'is_active' : ''" t-on-click="setTab">Explore map</button>
                    <button data-tab="findings" t-att-class="state.activeTab === 'findings' ? 'is_active' : ''" t-on-click="setTab">
                        Findings <span class="oav_tab_count"><t t-esc="state.dashboard.latest.finding_count"/></span>
                    </button>
                    <button data-tab="compare" t-att-class="state.activeTab === 'compare' ? 'is_active' : ''" t-on-click="setTab">Compare</button>
                </nav>

                <section t-if="state.activeTab === 'overview'" class="oav_overview">
                    <div class="oav_kpis">
                        <article class="oav_kpi oav_kpi_ink">
                            <span class="oav_kpi_label">Access surface</span>
                            <strong><t t-esc="state.dashboard.latest.node_count"/></strong>
                            <small>security objects mapped</small>
                        </article>
                        <article class="oav_kpi">
                            <span class="oav_kpi_label">Relationships</span>
                            <strong><t t-esc="state.dashboard.latest.edge_count"/></strong>
                            <small>permission paths captured</small>
                        </article>
                        <article class="oav_kpi oav_kpi_warn">
                            <span class="oav_kpi_label">Needs attention</span>
                            <strong><t t-esc="state.dashboard.latest.finding_count"/></strong>
                            <small>evidence-backed findings</small>
                        </article>
                        <article class="oav_kpi oav_kpi_critical">
                            <span class="oav_kpi_label">Critical</span>
                            <strong><t t-esc="state.dashboard.overview?.severity_counts?.critical || 0"/></strong>
                            <small>deterministic priority signals</small>
                        </article>
                    </div>

                    <div class="oav_start_panel">
                        <div class="oav_section_intro">
                            <div class="oav_kicker">WHERE TO START</div>
                            <h2>Three useful questions</h2>
                            <p>Choose a question instead of staring at the whole system.</p>
                        </div>
                        <div class="oav_start_grid">
                            <button class="oav_start_card" data-tab="findings" t-on-click="setTab">
                                <span class="oav_start_number">01</span>
                                <strong>What looks risky?</strong>
                                <span>Review the highest-signal findings first.</span>
                                <em>Open findings →</em>
                            </button>
                            <button class="oav_start_card" data-layer="group" t-on-click="openGraphLayer">
                                <span class="oav_start_number">02</span>
                                <strong>Who inherits access?</strong>
                                <span>Trace users, groups and implied roles.</span>
                                <em>Explore groups →</em>
                            </button>
                            <button class="oav_start_card" data-layer="model" t-on-click="openGraphLayer">
                                <span class="oav_start_number">03</span>
                                <strong>Who can touch a model?</strong>
                                <span>Start from a model and inspect its path.</span>
                                <em>Explore models →</em>
                            </button>
                        </div>
                    </div>

                    <div class="oav_path_panel">
                        <div class="oav_section_intro compact">
                            <div class="oav_kicker">THE PERMISSION PATH</div>
                            <h2>How Odoo access connects</h2>
                        </div>
                        <div class="oav_path">
                            <button t-foreach="state.dashboard.overview?.layers || []" t-as="layer" t-key="layer.type" class="oav_path_step" t-att-data-layer="layer.type" t-on-click="openGraphLayer">
                                <span class="oav_path_count"><t t-esc="layer.count"/></span>
                                <strong><t t-esc="layer.label"/></strong>
                                <span class="oav_path_type"><t t-esc="layer.type"/></span>
                            </button>
                        </div>
                    </div>

                    <div class="oav_findings_panel">
                        <div class="oav_panel_header">
                            <div>
                                <div class="oav_kicker">FIRST SIGNALS</div>
                                <h2>Findings worth opening</h2>
                            </div>
                            <button class="oav_link_button" data-tab="findings" t-on-click="setTab">View all →</button>
                        </div>
                        <div t-if="!state.findings.length" class="oav_no_findings">No findings in this snapshot.</div>
                        <div t-else="" class="oav_findings oav_findings_preview">
                            <button t-foreach="state.findings" t-as="finding" t-key="finding.id" class="oav_finding" t-att-data-finding-id="finding.id" t-att-class="`oav_finding oav_finding_${finding.severity}`" t-on-click="focusFinding">
                                <span class="oav_finding_severity"><t t-esc="finding.severity"/></span>
                                <span class="oav_finding_body">
                                    <strong><t t-esc="finding.title"/></strong>
                                    <span><t t-esc="finding.description"/></span>
                                </span>
                                <span class="oav_finding_arrow">↗</span>
                            </button>
                        </div>
                    </div>
                </section>

                <section t-if="state.activeTab === 'graph'" class="oav_graph_view">
                    <div class="oav_explorer_bar">
                        <div>
                            <div class="oav_kicker">FOCUSED INVESTIGATION</div>
                            <h2>Explore the permission map</h2>
                            <p>Pick one layer or search for a specific object. The map stays focused on what you asked.</p>
                        </div>
                        <div class="oav_explorer_controls">
                            <select class="form-select" t-att-value="state.filters.node_types[0] || ''" t-on-change="chooseLayer">
                                <option value="">Choose a layer…</option>
                                <option value="user">Users</option>
                                <option value="group">Security groups</option>
                                <option value="model">Models</option>
                                <option value="acl">Access controls</option>
                                <option value="rule">Record rules</option>
                                <option value="menu">Menus</option>
                            </select>
                            <input class="form-control" type="search" placeholder="Search a name or technical key…" t-model="state.filters.search"/>
                            <input class="form-control" type="search" placeholder="Module (optional)" t-model="state.filters.module"/>
                            <select class="form-select" t-att-value="state.filters.permission || ''" t-on-change="choosePermission" t-att-disabled="state.filters.node_types[0] !== 'model'">
                                <option value="">Any permission</option>
                                <option value="read">Can read</option>
                                <option value="write">Can write</option>
                                <option value="create">Can create</option>
                                <option value="delete">Can delete</option>
                            </select>
                            <small class="oav_filter_hint" t-if="state.filters.node_types[0] !== 'model'">Permission filters apply to Models.</small>
                            <select class="form-select" t-att-value="state.viewMode" t-on-change="chooseViewMode">
                                <option value="path">Access path</option>
                                <option value="neighborhood">Neighborhood</option>
                                <option value="matrix">Permission matrix</option>
                            </select>
                            <button class="btn oav_btn oav_btn_accent" t-on-click="applyGraphFilters"><i class="fa fa-crosshairs" aria-hidden="true"/> <span>Show map</span></button>
                            <button class="btn oav_btn oav_btn_ghost" t-on-click="clearGraphFilters"><i class="fa fa-rotate-left" aria-hidden="true"/> <span>Reset</span></button>
                        </div>
                    </div>
                    <section class="oav_legend" aria-label="Graph marking rules">
                        <div class="oav_legend_header">
                            <div>
                                <div class="oav_kicker">MARKING RULES</div>
                                <h3>How to read the map</h3>
                            </div>
                            <span class="oav_legend_hint">Color identifies the object type. Lines identify the relationship.</span>
                        </div>
                        <table class="oav_legend_table">
                            <thead><tr><th>Symbol</th><th>Object</th><th>Meaning</th></tr></thead>
                            <tbody>
                                <tr><td><span class="oav_legend_symbol oav_legend_category" aria-hidden="true"/></td><td>Module category</td><td>Application or module area</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_privilege" aria-hidden="true"/></td><td>Privilege</td><td>Named access privilege</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_user" aria-hidden="true"/></td><td>User</td><td>Individual account</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_group" aria-hidden="true"/></td><td>Security group</td><td>Role or inherited group</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_model" aria-hidden="true"/></td><td>Model</td><td>Business object or data model</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_acl" aria-hidden="true"/></td><td>Access control</td><td>Read, write, create, or delete access</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_rule" aria-hidden="true"/></td><td>Record rule</td><td>Row-level domain restriction</td></tr>
                                <tr><td><span class="oav_legend_symbol oav_legend_menu" aria-hidden="true"/></td><td>Menu</td><td>Navigation entry point</td></tr>
                            </tbody>
                        </table>
                        <div class="oav_edge_legend" aria-label="Relationship line rules">
                            <span><i class="oav_legend_line oav_line_default"/> Relationship</span>
                            <span><i class="oav_legend_line oav_line_implied"/> Implied access</span>
                            <span><i class="oav_legend_line oav_line_applies"/> Applies or protects</span>
                        </div>
                    </section>
                    <div t-if="state.graph.needs_focus" class="oav_focus_empty">
                        <div class="oav_focus_icon">⌁</div>
                        <h3>The full system is intentionally not shown at once</h3>
                        <p>Choose a layer or search above. Focused maps are easier to read and safer for large databases.</p>
                    </div>
                    <div t-elif="state.viewMode === 'matrix'" class="oav_matrix_panel">
                        <div class="oav_panel_header">
                            <div><div class="oav_kicker">PERMISSION MATRIX</div><h2>Who can do what</h2></div>
                            <span class="oav_map_hint">Click a model filter to narrow the matrix.</span>
                        </div>
                        <table class="oav_permission_matrix">
                            <thead><tr><th>Group</th><th>Model</th><th>Read</th><th>Write</th><th>Create</th><th>Delete</th></tr></thead>
                            <tbody>
                                <tr t-foreach="getPermissionMatrix()" t-as="row" t-key="row.key">
                                    <td><strong><t t-esc="row.group"/></strong></td><td><t t-esc="row.model"/></td>
                                    <td><span t-att-class="row.read ? 'oav_matrix_yes' : 'oav_matrix_no'"><t t-esc="row.read ? '✓' : '—'"/></span></td>
                                    <td><span t-att-class="row.write ? 'oav_matrix_yes' : 'oav_matrix_no'"><t t-esc="row.write ? '✓' : '—'"/></span></td>
                                    <td><span t-att-class="row.create ? 'oav_matrix_yes' : 'oav_matrix_no'"><t t-esc="row.create ? '✓' : '—'"/></span></td>
                                    <td><span t-att-class="row.delete ? 'oav_matrix_yes' : 'oav_matrix_no'"><t t-esc="row.delete ? '✓' : '—'"/></span></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="!getPermissionMatrix().length" class="oav_detail_empty">No group to model ACL path is available for this focus.</p>
                    </div>
                    <div t-else="" class="oav_content">
                        <section class="oav_graph_panel">
                            <div class="oav_panel_header">
                                <div>
                                    <div class="oav_kicker">RELATIONSHIP MAP</div>
                                    <h2><t t-esc="getGraphSummary(state.graph)"/></h2>
                                </div>
                                <span class="oav_map_hint">Scroll to zoom · drag to pan · select a node</span>
                            </div>
                            <div t-if="state.graph.budget_exceeded" class="oav_budget_notice">Map capped at <t t-esc="state.graph.render_limits.nodes"/> nodes. Narrow the search for a complete view.</div>
                            <div class="oav_graph" t-ref="graph"/>
                        </section>
                        <aside class="oav_detail_panel">
                            <div class="oav_detail_toolbar">
                                <div class="oav_kicker">SELECTED OBJECT</div>
                                <button t-if="state.selectedNode" class="oav_link_button" t-on-click="clearSelection"><i class="fa fa-eraser" aria-hidden="true"/> Clear highlight</button>
                            </div>
                            <h2>Why this object matters</h2>
                            <div t-if="state.selectedNode" class="oav_detail">
                                <h3><t t-esc="state.selectedNode.node.label"/></h3>
                                <div class="oav_detail_type"><t t-esc="state.selectedNode.node.type"/></div>
                                <dl>
                                    <dt>Source</dt><dd><t t-esc="state.selectedNode.node.source_model"/> #<t t-esc="state.selectedNode.node.source_id"/></dd>
                                    <dt>Module</dt><dd><t t-esc="state.selectedNode.node.module"/></dd>
                                </dl>
                                <div class="oav_detail_section" t-if="getAccessModes(state.selectedNode.access_summary).length">
                                    <div class="oav_detail_label">Effective access</div>
                                    <div class="oav_access_modes">
                                        <span t-foreach="getAccessModes(state.selectedNode.access_summary)" t-as="mode" t-key="mode.key" class="oav_mode_chip">
                                            <i class="fa fa-check"/> <t t-esc="mode.label"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="oav_detail_section" t-if="state.selectedNode.access_summary?.rule_count">
                                    <div class="oav_detail_label">Record rule impact</div>
                                    <p class="oav_detail_note"><t t-esc="state.selectedNode.access_summary.rule_count"/> related record rule(s) constrain this path.</p>
                                </div>
                                <div class="oav_detail_section" t-if="state.selectedNode.relationships?.length">
                                    <div class="oav_detail_label">Evidence path</div>
                                    <ul class="oav_relationships">
                                        <li t-foreach="state.selectedNode.relationships" t-as="relationship" t-key="`${relationship.edge_type}-${relationship.node.id}`" class="oav_relationship">
                                            <span class="oav_relationship_edge"><t t-esc="relationship.edge_type"/></span>
                                            <span><t t-esc="relationship.node.label"/></span>
                                            <small><t t-esc="relationship.node.type"/></small>
                                        </li>
                                    </ul>
                                </div>
                                <pre class="oav_metadata"><t t-esc="formatJson(state.selectedNode.node.metadata)"/></pre>
                            </div>
                            <p t-else="" class="oav_detail_empty">Click any node to see its source, relationships and evidence.</p>
                        </aside>
                    </div>
                </section>

                <section t-if="state.activeTab === 'compare'" class="oav_compare_view">
                    <div class="oav_explorer_bar compact_bar">
                        <div>
                            <div class="oav_kicker">CHANGE INTELLIGENCE</div>
                            <h2>Compare security snapshots</h2>
                            <p>See what changed since the selected completed snapshot.</p>
                        </div>
                        <select class="form-select oav_compare_select" t-att-value="state.compareBaselineId || ''" t-on-change="chooseCompareBaseline">
                            <option value="">Choose baseline snapshot</option>
                            <option t-foreach="state.dashboard.recent_snapshots || []" t-as="snapshot" t-key="snapshot.id" t-if="snapshot.id !== state.dashboard.latest.id" t-att-value="snapshot.id">
                                <t t-esc="snapshot.name"/>
                            </option>
                        </select>
                    </div>
                    <div t-if="!state.compare" class="oav_focus_empty">
                        <div class="oav_focus_icon">↔</div>
                        <h3>Choose a baseline to see changes</h3>
                        <p>The comparison is read-only and includes nodes, relationships and findings.</p>
                    </div>
                    <div t-else="" class="oav_compare_content">
                        <div t-if="state.compare.nodes.truncated.source or state.compare.edges.truncated.source or state.compare.findings.truncated.source" class="oav_budget_notice">This comparison is capped at 500 records per category. Narrow the snapshots or use a future paged detail view for the complete change set.</div>
                        <div class="oav_compare_summary">
                            <article class="oav_compare_card"><strong><t t-esc="state.compare.summary.nodes_added"/></strong><span>Objects added</span></article>
                            <article class="oav_compare_card"><strong><t t-esc="state.compare.summary.nodes_removed"/></strong><span>Objects removed</span></article>
                            <article class="oav_compare_card"><strong><t t-esc="state.compare.summary.nodes_changed"/></strong><span>Objects changed</span></article>
                            <article class="oav_compare_card"><strong><t t-esc="state.compare.summary.edges_added"/></strong><span>Relationships added</span></article>
                            <article class="oav_compare_card"><strong><t t-esc="state.compare.summary.findings_added"/></strong><span>New findings</span></article>
                        </div>
                        <section class="oav_compare_panel">
                            <div class="oav_panel_header"><div><div class="oav_kicker">OBJECT CHANGES</div><h2>What moved</h2></div></div>
                            <div class="oav_compare_columns">
                                <div><h3>Added</h3><ul><li t-foreach="state.compare.nodes.added" t-as="item" t-key="`a-${item.id}`"><span class="oav_change_badge oav_change_added">+</span><t t-esc="item.label"/><small><t t-esc="item.type"/></small></li></ul></div>
                                <div><h3>Removed</h3><ul><li t-foreach="state.compare.nodes.removed" t-as="item" t-key="`r-${item.id}`"><span class="oav_change_badge oav_change_removed">−</span><t t-esc="item.label"/><small><t t-esc="item.type"/></small></li></ul></div>
                            </div>
                        </section>
                        <section class="oav_compare_panel">
                            <div class="oav_panel_header"><div><div class="oav_kicker">SECONDARY CHANGES</div><h2>Relationships and findings</h2></div></div>
                            <div class="oav_compare_columns">
                                <div><h3>Relationships added</h3><ul><li t-foreach="state.compare.edges.added" t-as="item" t-key="`ea-${item.id}`"><span class="oav_change_badge oav_change_added">+</span><t t-esc="item.type"/><small><t t-esc="item.source"/> → <t t-esc="item.target"/></small></li></ul></div>
                                <div><h3>Findings added</h3><ul><li t-foreach="state.compare.findings.added" t-as="item" t-key="`fa-${item.fingerprint}`"><span class="oav_change_badge oav_change_added">+</span><t t-esc="item.title"/><small><t t-esc="item.severity"/></small></li></ul></div>
                            </div>
                        </section>
                    </div>
                </section>

                <section t-if="state.activeTab === 'findings'" class="oav_findings_view">
                    <div class="oav_explorer_bar compact_bar">
                        <div>
                            <div class="oav_kicker">EVIDENCE QUEUE</div>
                            <h2>Findings, ordered for action</h2>
                            <p>Critical means structurally strong evidence. Warning means investigate the context.</p>
                        </div>
                    </div>
                    <div class="oav_findings oav_findings_full">
                        <button t-foreach="state.findings" t-as="finding" t-key="finding.id" class="oav_finding" t-att-data-finding-id="finding.id" t-att-class="`oav_finding oav_finding_${finding.severity}`" t-on-click="focusFinding">
                            <span class="oav_finding_severity"><t t-esc="finding.severity"/></span>
                            <span class="oav_finding_body">
                                <strong><t t-esc="finding.title"/></strong>
                                <span><t t-esc="finding.description"/></span>
                                <small><t t-esc="finding.recommendation"/></small>
                            </span>
                            <span class="oav_finding_arrow">↗</span>
                        </button>
                    </div>
                </section>
            </main>
        </div>
    </t>
</templates>
