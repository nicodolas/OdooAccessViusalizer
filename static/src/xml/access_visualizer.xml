<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_access_visualizer.AccessVisualizerAction" owl="1">
        <div class="oav_root">
            <div class="oav_header">
                <div>
                    <h1>Odoo Access Visualizer</h1>
                    <p class="oav_subtitle">Read-only security map and evidence-backed findings</p>
                </div>
                <div class="oav_actions">
                    <button class="btn btn-primary" t-on-click="enqueueScan">
                        <i class="fa fa-refresh me-1"/> Rescan
                    </button>
                    <button class="btn btn-secondary" t-on-click="reload">
                        <i class="fa fa-repeat me-1"/> Refresh
                    </button>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-danger" role="alert">
                <t t-esc="state.error"/>
            </div>
            <div t-if="state.loading" class="oav_state_card">
                <i class="fa fa-spinner fa-spin me-2"/> Loading snapshot…
            </div>
            <div t-if="!state.loading and !state.dashboard?.latest" class="oav_state_card">
                <h3>No completed snapshot</h3>
                <p>Run the first read-only security scan to build the map.</p>
                <button class="btn btn-primary" t-on-click="enqueueScan">Run first scan</button>
            </div>

            <div t-if="!state.loading and state.dashboard?.latest" class="oav_dashboard">
                <div class="oav_toolbar">
                    <div class="oav_filters">
                        <input class="form-control" type="search" placeholder="Search nodes…" t-model="state.filters.search" t-on-keyup="applyFilters"/>
                    </div>
                    <div class="oav_summary">
                        <span><strong><t t-esc="state.dashboard.latest.node_count"/></strong> nodes</span>
                        <span><strong><t t-esc="state.dashboard.latest.edge_count"/></strong> edges</span>
                        <span class="oav_finding_count"><strong><t t-esc="state.dashboard.latest.finding_count"/></strong> findings</span>
                        <span t-if="state.dashboard.active" class="badge text-bg-info">Scan in progress</span>
                    </div>
                </div>

                <div t-if="state.graph.budget_exceeded" class="alert alert-warning" role="alert">
                    The current filter exceeds the render budget. Showing a bounded view; refine the search for complete detail.
                </div>

                <div class="oav_content">
                    <section class="oav_graph_panel">
                        <div class="oav_panel_header">
                            <h2>Security relationship map</h2>
                            <span class="text-muted">Scroll to zoom · drag to pan · select a node for details</span>
                        </div>
                        <div class="oav_graph" t-ref="graph"/>
                    </section>
                    <aside class="oav_detail_panel">
                        <h2>Node details</h2>
                        <div t-if="state.selectedNode" class="oav_detail">
                            <h3><t t-esc="state.selectedNode.node.label"/></h3>
                            <dl>
                                <dt>Type</dt><dd><t t-esc="state.selectedNode.node.type"/></dd>
                                <dt>Source</dt><dd><t t-esc="state.selectedNode.node.source_model"/> #<t t-esc="state.selectedNode.node.source_id"/></dd>
                                <dt>Module</dt><dd><t t-esc="state.selectedNode.node.module"/></dd>
                            </dl>
                            <pre class="oav_metadata"><t t-esc="formatJson(state.selectedNode.node.metadata)"/></pre>
                        </div>
                        <p t-else="" class="text-muted">Select a node to inspect its evidence.</p>
                    </aside>
                </div>

                <section class="oav_findings_panel">
                    <div class="oav_panel_header">
                        <h2>Findings</h2>
                        <span class="text-muted">Critical findings are deterministic; warnings may be heuristic.</span>
                    </div>
                    <div t-if="!state.findings.length" class="text-muted">No findings in this snapshot.</div>
                    <div t-else="" class="oav_findings">
                        <article t-foreach="state.findings" t-as="finding" t-key="finding.id" t-att-class="`oav_finding oav_finding_${finding.severity}`">
                            <div class="oav_finding_badges">
                                <span class="badge" t-att-class="`text-bg-${finding.severity === 'critical' ? 'danger' : 'warning'}`"><t t-esc="finding.severity"/></span>
                                <span class="badge text-bg-light"><t t-esc="finding.certainty"/></span>
                            </div>
                            <h3><t t-esc="finding.title"/></h3>
                            <p><t t-esc="finding.description"/></p>
                            <small><strong>Recommendation:</strong> <t t-esc="finding.recommendation"/></small>
                        </article>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
